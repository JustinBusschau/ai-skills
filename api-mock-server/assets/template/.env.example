# Loaded automatically from .env at startup; variables set in the shell take precedence.
# npm run verify ignores both, and tests the defaults. Needs Node.js 22.13+ (22.x), 24.x, or 26+.

# Interface to bind. 127.0.0.1 keeps the mock on this machine. Anything else (Docker
# sets 0.0.0.0) is a shared instance: MOCK_ADMIN_TOKEN and MOCK_CONTROL_TOKEN become
# mandatory and webhook delivery is off until MOCK_WEBHOOK_ALLOWED_HOSTS is set.
HOST=127.0.0.1
PORT=4010
# Path prefix for the API, e.g. /v1. Leave unset to use the path of the spec's first server URL.
# MOCK_BASE_PATH=
# Idle minutes before a session's state is discarded and re-seeded on next use.
MOCK_SESSION_TTL_MINUTES=1440
# Most sessions held at once; beyond this the least recently used is discarded.
MOCK_MAX_SESSIONS=500
# The control plane always needs a token. Leave both empty on a local mock to have them
# generated at first start, printed, and saved in .mock-tokens (git-ignored, mode 600),
# which later starts reuse. A shared instance must be given both explicitly.
# Token for global operations (reset every session, list sessions, unredacted state).
MOCK_ADMIN_TOKEN=
# Token for session operations (reset, state, arm, clock, requests, webhooks).
# Give it to testers; keep the admin token for whoever runs the instance.
MOCK_CONTROL_TOKEN=
# Where generated tokens are saved.
# MOCK_TOKENS_FILE=.mock-tokens
# Whether the catalogue (/__mock, /__mock/personas, /__mock/scenarios, /__mock/docs,
# /__mock/openapi.json), which shows persona credentials, needs the control token too:
# open (default) or token. Browsers are prompted for it (any user name, token as password).
MOCK_CATALOGUE_ACCESS=open
# The mock's public base URL behind a proxy, e.g. https://mock.example.com. Used in the docs'
# curl examples and accepted as the mock's own origin. Defaults to the requesting host.
# MOCK_PUBLIC_URL=
# Browser origins (besides this server) allowed to call /__mock, comma-separated,
# e.g. https://app.dev.example. Empty: any localhost origin on a loopback-bound mock,
# none on a shared one.
# MOCK_CONTROL_ORIGINS=
# Set to true only if you accept that anyone who can reach this mock (local or shared) can
# read and reset every session.
MOCK_ALLOW_OPEN_CONTROL=false
# Comma-separated origins for CORS, or * for any.
MOCK_CORS_ORIGINS=*
# Contract checking of responses and webhook payloads: strict turns a violation into
# a 500 (webhooks are not delivered), warn logs it and carries on, off disables it.
MOCK_RESPONSE_VALIDATION=strict
# Hosts (or host:port) webhooks may be delivered to, comma-separated. Defaults to
# localhost and 127.0.0.1 when bound to loopback, and to none on a shared instance.
# Targets on this machine's loopback always need the admin token to register.
# MOCK_WEBHOOK_ALLOWED_HOSTS=
# Default clock for new sessions: live (real time plus any advances) or frozen
# (time moves only through /__mock/clock/advance), and the frozen start time.
MOCK_CLOCK=live
# MOCK_CLOCK_START=2026-03-02T09:00:00Z
# Longest delay.<ms> scenario accepted, and how long fault.timeout holds a connection.
MOCK_MAX_DELAY_MS=120000
MOCK_TIMEOUT_FAULT_MS=65000
